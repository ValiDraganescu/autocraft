 "_about": [
  "F2 reference scenes: one row per Swift `windowshot` scene and its Unreal twin.",
  "Read by Source/Autocraft/AcShotScenes.cpp (-AcScene=NAME) and Tools/shots/compare.py.",
  "map: style-size (Swift --map/--size, Unreal -AcMap); zoom/at: Swift --zoom/--at, Unreal -AcZoom/-AcCamAt;",
  "warm: Swift --warm, Unreal -AcWarm; still: Unreal -AcPaused after the warm (Swift's picture is a still);",
  "frames: Unreal -AcShotFrames; env: the Swift run's environment; ue: null = no Unreal staging yet;",
  "owners: the chunks that own what the scene shows (GAME-LAYER.md section 4)."
 ],
